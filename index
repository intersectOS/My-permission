    async function handleSaveNewPassword(e) {
      e.preventDefault();
      const cur = document.getElementById('pwd-current').value.trim();
      const nw = document.getElementById('pwd-new').value.trim();
      const conf = document.getElementById('pwd-confirm').value.trim();
      const msg = document.getElementById('pwd-change-msg');
      const saveBtn = document.getElementById('btn-save-pwd');

      saveBtn.disabled = true;
      saveBtn.innerText = "جارٍ الحفظ والتعميم سحابياً...";

      const expectedCur = await getAdminPasswordAsync();

      if (cur !== expectedCur) {
        msg.className = 'block p-2.5 rounded-xl text-center bg-rose-50 text-rose-700 text-xs font-bold';
        msg.innerText = 'كلمة المرور الحالية غير صحيحة!';
        saveBtn.disabled = false;
        saveBtn.innerText = "حفظ وتعميم كلمة المرور ✓";
        return;
      }

      if (nw !== conf) {
        msg.className = 'block p-2.5 rounded-xl text-center bg-rose-50 text-rose-700 text-xs font-bold';
        msg.innerText = 'كلمة المرور الجديدة غير متطابقة مع خانة التأكيد!';
        saveBtn.disabled = false;
        saveBtn.innerText = "حفظ وتعميم كلمة المرور ✓";
        return;
      }

      if (nw.length < 6) {
        msg.className = 'block p-2.5 rounded-xl text-center bg-rose-50 text-rose-700 text-xs font-bold';
        msg.innerText = 'يجب ألا تقل كلمة المرور عن 6 خانات!';
        saveBtn.disabled = false;
        saveBtn.innerText = "حفظ وتعميم كلمة المرور ✓";
        return;
      }

      // التحديث التلقائي في سحابة Supabase ليراها جميع أجهزة المدرسة فوراً
      if (isLiveSupabase && supabaseClient) {
        try {
          await supabaseClient.from('school_settings').upsert({
            setting_key: 'admin_password',
            setting_value: nw,
            updated_at: new Date().toISOString()
          });
        } catch (err) {
          console.warn("تنبيه: تعذر الحفظ في جدول Supabase، تم الحفظ محلياً:", err);
