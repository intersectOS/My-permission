<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>منصة استئذاني - مدرسة ابتدائية إبن الهيثم (بنين)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Tajawal', sans-serif; }
    .ltr { direction: ltr; unicode-bidi: embed; }
    .inp { width: 100%; padding: .7rem; background: #fff; border: 1px solid #cbd5e1; border-radius: .75rem; font-size: .875rem; font-weight: 700; color: #1e293b; }
    .inp:focus { outline: none; border-color: #059669; }
    .lbl { display: block; font-size: .75rem; font-weight: 700; color: #334155; margin-bottom: .25rem; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col antialiased">

  <!-- ==================== الترويسة الرئيسية ==================== -->
  <header class="bg-emerald-800 text-white shadow-lg sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4 text-center md:text-right">
        <div class="w-14 h-14 bg-white text-emerald-800 rounded-2xl flex items-center justify-center font-black text-2xl shadow-md border-2 border-emerald-400/40">🏫</div>
        <div>
          <div class="flex items-center gap-2 justify-center md:justify-start">
            <span class="text-xs bg-emerald-700/80 text-emerald-200 px-2.5 py-0.5 rounded-full font-bold">وزارة التعليم 🇸🇦 تعليم حائل</span>
          </div>
          <h1 class="text-xl md:text-2xl font-black tracking-tight mt-0.5">مدرسة ابتدائية إبن الهيثم (بنين)</h1>
          <p class="text-xs text-emerald-200 font-medium">منصة "استئذاني" الموحدة - نظام تنظيم خروج واستئذان الطلاب</p>
        </div>
      </div>
      <nav class="bg-emerald-900/60 p-1.5 rounded-2xl flex items-center gap-1 border border-emerald-600/40">
        <button id="tab-btn-parent" onclick="switchMainTab('parent')" class="px-5 py-2.5 rounded-xl font-black text-sm transition-all duration-200 bg-white text-emerald-900 shadow-md">👨‍👦 بوابة ولي الأمر</button>
        <button id="tab-btn-admin" onclick="switchMainTab('admin')" class="px-5 py-2.5 rounded-xl font-black text-sm transition-all duration-200 text-white/90 hover:text-white hover:bg-emerald-800/60">🔒 لوحة إدارة المدرسة</button>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-8 w-full flex-1">

    <!-- ======================================================== -->
    <!-- 1️⃣ بوابة ولي الأمر                                       -->
    <!-- ======================================================== -->
    <section id="view-parent" class="max-w-xl mx-auto space-y-6">
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 text-center">
        <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 rounded-full text-xs font-black mb-2">خدمة الاستئذان المعتمدة</span>
        <h2 class="text-2xl font-black text-slate-800">طلب استئذان طالب</h2>
        <p class="text-slate-500 text-sm mt-1">أهلاً بكم في المنصة الرسمية لمدرسة ابتدائية إبن الهيثم (بنين) بحائل. يرجى إدخال هويتكم للبدء.</p>
      </div>

      <div class="bg-white p-6 sm:p-8 rounded-3xl shadow-lg border border-slate-200">

        <!-- الخطوة 1 -->
        <div id="parent-step-1" class="space-y-6">
          <div>
            <label class="block text-slate-700 font-black text-base sm:text-lg mb-2">رقم الهوية الوطنية لولي الأمر:</label>
            <input type="text" id="parent-national-id" maxlength="10" inputmode="numeric" placeholder="1012345678"
                   class="w-full p-4 sm:p-5 text-center text-2xl sm:text-3xl font-black tracking-widest bg-slate-50 border-2 border-slate-300 rounded-2xl focus:bg-white focus:border-emerald-600 focus:outline-none transition text-slate-800">
            <p class="text-xs text-slate-400 mt-2 font-medium">💡 أدخل رقم الهوية المعتمد والمسجل في سجلات مدرسة ابتدائية إبن الهيثم (بنين).</p>
          </div>
          <button onclick="parentCheckIdentity()" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xl rounded-2xl shadow-lg shadow-emerald-600/30 transition flex items-center justify-center gap-2">
            <span>إرسال رمز التحقق</span><span>📲</span>
          </button>
        </div>

        <!-- الخطوة 2 -->
        <div id="parent-step-2" class="space-y-6 hidden">
          <div class="text-center space-y-2">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-700 rounded-2xl flex items-center justify-center text-2xl mx-auto font-black">📩</div>
            <h3 class="text-lg font-black text-slate-800">أدخل رمز التحقق (OTP)</h3>
            <p class="text-xs sm:text-sm text-slate-500">تم إرسال الرمز إلى رقم الجوال المسجل لدى المدرسة:</p>
            <p id="parent-masked-phone" class="text-base font-black text-emerald-700 ltr"></p>
            <p class="text-[11px] text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-2 py-1 inline-block font-bold">عرض تجريبي: الرمز 123456</p>
          </div>
          <input type="text" id="parent-otp-input" maxlength="6" inputmode="numeric" placeholder="• • • • • •"
                 class="w-full p-4 sm:p-5 text-center text-3xl font-black tracking-widest bg-slate-50 border-2 border-slate-300 rounded-2xl focus:bg-white focus:border-emerald-600 focus:outline-none transition text-slate-800">
          <div class="space-y-2">
            <button onclick="parentVerifyOtp()" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xl rounded-2xl shadow-lg shadow-emerald-600/30 transition">تأكيد الرمز والمتابعة 🔑</button>
            <button onclick="parentBackToStep1()" class="w-full py-2.5 text-slate-500 hover:text-slate-800 font-bold text-xs transition">← تغيير رقم الهوية</button>
          </div>
        </div>

        <!-- الخطوة 3 -->
        <div id="parent-step-3" class="space-y-6 hidden">
          <p id="parent-greeting" class="text-sm font-black text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-3 py-2"></p>
          <div class="border-b pb-4">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h3 class="text-lg font-black text-slate-800">حدد الطلاب المراد استئذانهم:</h3>
                <p class="text-xs text-slate-500">اختر طالباً واحداً أو أكثر من القائمة</p>
              </div>
              <button onclick="parentToggleSelectAll()" id="btn-select-all" class="px-3 py-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-xl font-bold text-xs hover:bg-emerald-100 transition">تحديد الكل ✓</button>
            </div>
            <div id="parent-students-list" class="space-y-3"></div>
          </div>

          <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-4">
            <div class="flex items-center gap-2"><span class="text-base">📝</span><h4 class="font-black text-sm text-slate-700">بيانات استلام الطالب:</h4></div>
            <div>
              <label class="lbl">من سيستلم الطالب؟</label>
              <select id="parent-pickup-select" onchange="onPickupSelectChange()" class="inp"></select>
              <input type="text" id="parent-pickup-person" placeholder="اكتب اسم المستلم الكامل" class="inp mt-2 hidden">
              <p id="pickup-warning" class="hidden text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-2 mt-2">⚠️ المستلم غير مسجل ضمن المفوَّضين، وستتحقق الإدارة من هويته عند البوابة.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div><label class="lbl">وقت الاستئذان التقريبي:</label><input type="time" id="parent-pickup-time" class="inp"></div>
              <div><label class="lbl">نوع ولون السيارة (إن وُجد):</label><input type="text" id="parent-car-info" placeholder="مثال: يوكن أسود" class="inp"></div>
            </div>
          </div>

          <button onclick="parentSubmitRequest()" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-xl rounded-2xl shadow-xl shadow-emerald-600/30 transition flex items-center justify-center gap-2">
            <span>تأكيد وإرسال طلب الاستئذان للمدرسة</span><span>🚀</span>
          </button>
        </div>

        <!-- الخطوة 4 -->
        <div id="parent-step-4" class="space-y-6 text-center py-6 hidden">
          <div class="w-20 h-20 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center text-4xl mx-auto shadow-inner">✓</div>
          <div>
            <span class="text-xs bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-black">تم إشعار إدارة المدرسة</span>
            <h3 class="text-2xl font-black text-slate-900 mt-2">تم إرسال طلب الاستئذان بنجاح!</h3>
            <p class="text-sm text-slate-600 mt-2 max-w-sm mx-auto">وصل طلبكم إلى شاشة وكيل المدرسة، وسيتم تجهيز الطالب عند البوابة.</p>
          </div>
          <div id="parent-summary-box" class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-right text-xs font-bold space-y-1.5 text-slate-700"></div>
          <button onclick="parentResetAll()" class="px-8 py-3 bg-slate-200 hover:bg-slate-300 text-slate-800 font-black rounded-xl text-sm transition">تقديم طلب استئذان آخر ↺</button>
        </div>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- 2️⃣ لوحة الإدارة                                          -->
    <!-- ======================================================== -->
    <section id="view-admin" class="hidden space-y-6">

      <!-- تسجيل الدخول -->
      <div id="admin-auth-gate" class="max-w-md mx-auto bg-white p-8 rounded-3xl shadow-xl border border-slate-200 space-y-6 text-center">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-800 rounded-2xl flex items-center justify-center text-3xl mx-auto shadow-inner">🔐</div>
        <div>
          <h3 class="text-xl font-black text-slate-900">تسجيل دخول إدارة المدرسة</h3>
          <p class="text-xs text-slate-500 mt-1">منطقة محمية خاصة بوكلاء ومسؤولي مدرسة ابتدائية إبن الهيثم (بنين)</p>
        </div>
        <form onsubmit="handleAdminLogin(event)" class="space-y-4 text-right">
          <div>
            <label class="lbl">كلمة مرور الإدارة:</label>
            <div class="relative">
              <input type="password" id="input-admin-password" placeholder="أدخل كلمة المرور" required class="w-full p-3.5 bg-slate-50 border-2 border-slate-200 rounded-xl text-sm font-mono font-bold text-slate-800 focus:outline-none focus:border-emerald-600 focus:bg-white transition">
              <button type="button" onclick="togglePasswordVisibility('input-admin-password')" class="absolute left-3 top-3.5 text-slate-400 hover:text-slate-600 text-sm">👁️</button>
            </div>
          </div>
          <div id="admin-login-error" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs font-bold rounded-xl text-center">كلمة المرور غير صحيحة، يرجى المحاولة مرة أخرى!</div>
          <button id="admin-login-btn" type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-black text-base rounded-xl shadow-lg shadow-emerald-600/20 transition flex items-center justify-center gap-2"><span>دخول للوحة التحكم 🚪</span></button>
        </form>
      </div>

      <!-- محتوى الإدارة -->
      <div id="admin-dashboard-content" class="hidden space-y-6">

        <div class="bg-white p-5 rounded-3xl shadow-sm border border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs bg-emerald-100 text-emerald-800 font-black px-2.5 py-1 rounded-full">شاشة الإدارة المدرسية المباشرة</span>
            <h2 class="text-2xl font-black text-slate-900 mt-1">مدرسة ابتدائية إبن الهيثم (بنين) - حائل 🏫</h2>
            <p class="text-xs text-slate-500 font-medium">متابعة استئذان الطلاب لحظياً، سجل أولياء الأمور، والترحيل السنوي للصفوف</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <div id="status-live-indicator" class="flex items-center gap-2 bg-emerald-50 border border-emerald-200 text-emerald-800 px-3 py-2 rounded-xl text-xs font-bold">
              <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
              <span id="backend-label">متصل سحابياً مع Supabase ✓</span>
            </div>
            <button type="button" onclick="openChangePasswordModal()" class="px-3 py-2 bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-900 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm"><span>🔑</span> تغيير كلمة المرور</button>
            <button type="button" onclick="handleAdminLogout()" class="px-3 py-2 bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 rounded-xl text-xs font-bold transition flex items-center gap-1"><span>🚪</span> خروج</button>
          </div>
        </div>

        <!-- مؤشرات سريعة -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm"><p class="text-xs font-bold text-slate-500">📋 طلبات اليوم</p><p id="stat-today" class="text-3xl font-black text-slate-900 mt-1">0</p></div>
          <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-sm"><p class="text-xs font-bold text-amber-700">⏳ قيد الانتظار</p><p id="stat-pending" class="text-3xl font-black text-amber-700 mt-1">0</p></div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm"><p class="text-xs font-bold text-slate-500">👥 أولياء الأمور</p><p id="stat-parents" class="text-3xl font-black text-slate-900 mt-1">0</p></div>
          <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm"><p class="text-xs font-bold text-slate-500">🎒 الطلاب الحاليون</p><p id="stat-students" class="text-3xl font-black text-slate-900 mt-1">0</p></div>
        </div>

        <!-- التبويبات -->
        <div class="flex flex-wrap gap-2 border-b border-slate-200 pb-3">
          <button id="admin-subtab-orders" onclick="switchAdminTab('orders')">📋 الطلبات الواردة (<span id="orders-count">0</span>)</button>
          <button id="admin-subtab-parents" onclick="switchAdminTab('parents')">👥 سجل أولياء الأمور</button>
          <button id="admin-subtab-add" onclick="switchAdminTab('add')">➕ تسجيل ولي أمر</button>
          <button id="admin-subtab-promote" onclick="switchAdminTab('promote')">🎓 ترحيل الصفوف السنوية</button>
        </div>

        <!-- 1) الطلبات -->
        <div id="admin-panel-orders" class="space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-black text-slate-800 text-lg">سجل استئذان اليوم المباشر</h3>
            <button onclick="refreshOrders()" class="text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1">🔄 تحديث يدوي</button>
          </div>
          <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-right text-xs sm:text-sm">
                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200">
                  <tr>
                    <th class="p-4">الطالب</th><th class="p-4">الصف والشعبة</th><th class="p-4">ولي الأمر</th><th class="p-4">المستلم</th>
                    <th class="p-4">الوقت المجدول</th><th class="p-4">السيارة</th><th class="p-4 text-center">الحالة</th><th class="p-4 text-center">الإجراء</th>
                  </tr>
                </thead>
                <tbody id="admin-orders-table" class="divide-y divide-slate-100 font-medium"></tbody>
              </table>
            </div>
            <div id="no-orders-msg" class="p-8 text-center text-slate-400 font-bold text-sm hidden">لا توجد طلبات استئذان حالية حتى الآن.</div>
          </div>
        </div>

        <!-- 2) سجل أولياء الأمور -->
        <div id="admin-panel-parents" class="hidden space-y-4">
          <div class="bg-white p-5 rounded-3xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div>
                <h3 class="text-lg font-black text-slate-900">سجل أولياء الأمور</h3>
                <p class="text-xs text-slate-500 font-medium" id="parents-count-label"></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <button onclick="toggleRevealSensitive()" id="btn-reveal" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-700 rounded-xl text-xs font-bold">👁️ إظهار الأرقام كاملة</button>
                <button onclick="exportParentsCSV()" class="px-3 py-2 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-800 rounded-xl text-xs font-bold">⬇️ تصدير Excel</button>
                <button onclick="switchAdminTab('add')" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold">➕ ولي أمر جديد</button>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
              <input id="parents-search" oninput="renderParentsRegistry()" placeholder="🔍 ابحث بالاسم أو الهوية أو الجوال أو اسم الطالب" class="inp md:col-span-2 bg-slate-50">
              <select id="parents-filter" onchange="renderParentsRegistry()" class="inp bg-slate-50">
                <option value="all">جميع أولياء الأمور</option>
                <option value="verified">الجوال موثّق في أبشر</option>
                <option value="unverified">الجوال غير موثّق</option>
                <option value="notes">لديهم ملاحظات / تنبيهات</option>
              </select>
            </div>
          </div>
          <div id="parents-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-4"></div>
          <div id="no-parents-msg" class="hidden bg-white p-8 rounded-3xl border border-slate-200 text-center text-slate-400 font-bold text-sm">لا توجد نتائج مطابقة.</div>
        </div>

        <!-- 3) تسجيل ولي أمر -->
        <div id="admin-panel-add" class="hidden bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
          <div class="border-b pb-4">
            <h3 class="text-lg font-black text-slate-800">تسجيل ولي أمر وربط أبنائه في المدرسة</h3>
            <p class="text-xs text-slate-500 mt-1">الحقول المعلّمة بـ * إلزامية. رقم الجوال هو الذي يصله رمز التحقق OTP.</p>
          </div>
          <form onsubmit="handleSaveParentAndStudents(event)" class="space-y-6">
            <div id="add-form-body" class="space-y-6"></div>
            <div class="pt-2 flex justify-end">
              <button type="submit" class="px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm rounded-xl shadow-lg shadow-emerald-600/20 active:scale-95 transition">حفظ وربط البيانات في النظام ✓</button>
            </div>
          </form>
        </div>

        <!-- 4) الترحيل -->
        <div id="admin-panel-promote" class="hidden bg-white p-6 sm:p-8 rounded-3xl shadow-sm border border-slate-200 space-y-6">
          <div class="border-b pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="text-xs bg-indigo-50 text-indigo-700 font-black px-2.5 py-1 rounded-full">نهاية العام الدراسي 🎓</span>
              <h3 class="text-xl font-black text-slate-900 mt-1">ترحيل وترقية صفوف طلاب ابتدائية إبن الهيثم</h3>
              <p class="text-xs text-slate-500 mt-1">ترقية الطلاب تلقائياً للسنة التالية. طلاب الصف السادس ينتقلون إلى "تم التخرج الله يوفقه 🎓" مع بقاء أسمائهم محفوظة.</p>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" onclick="promoteSelectAll(true)" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl">تحديد الكل ✓</button>
              <button type="button" onclick="promoteSelectAll(false)" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl">إلغاء التحديد ✕</button>
            </div>
          </div>
          <div class="bg-amber-50 border border-amber-200 p-4 rounded-2xl flex items-start gap-3 text-xs text-amber-800">
            <span class="text-lg">💡</span>
            <div><p class="font-black mb-0.5">الطالب الباقي للإعادة:</p><p>أزل علامة الصح من أمام اسمه وسيبقى في صفه دون ترقية.</p></div>
          </div>
          <div class="border border-slate-200 rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-right text-xs sm:text-sm">
