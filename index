    async function loadParents() {
      if (isLiveSupabase) {
        try {
          const { data, error } = await supabaseClient.from('parent_students').select('*, students(id, full_name, grade_class)');
          if (error) throw error;
          parentsCache = groupParentRows(data || []);
        } catch (e) {
          console.error(e);
          showCustomAlert('تعذر جلب سجل أولياء الأمور: ' + (e.message || ''));
        }
      } else {
        parentsCache = localMockDB.parents.map(normParent);
      }
      updateStats();
      return parentsCache;
    }

    async function fetchParentByNid(nid) {
      if (isLiveSupabase) {
        const { data, error } = await supabaseClient.from('parent_students').select('*, students(id, full_name, grade_class)').eq('parent_national_id', nid);
        if (error) { console.error(error); return null; }
        return groupParentRows(data || [])[0] || null;
      }
      const p = localMockDB.parents.find(x => x.parent_id === nid);
      return p ? normParent(p) : null;
    }

    // ==========================================
    // 👨‍👦 تجربة ولي الأمر
    // ==========================================
    let currentParentData = null;
    let currentSelectedStudentIds = [];

    async function parentCheckIdentity() {
      const nid = document.getElementById('parent-national-id').value.trim();
      if (!NID_RE.test(nid)) return showCustomAlert('فضلاً أدخل رقم هوية صحيح مكوّن من 10 أرقام');

      const parent = await fetchParentByNid(nid);
      if (!parent) return showCustomAlert('رقم الهوية هذا غير مسجل في المدرسة. يرجى التواصل مع إدارة المدرسة لإضافتكم.');

      currentParentData = parent;
      const phone = parent.parent_phone || '0500000000';
      document.getElementById('parent-masked-phone').innerText = phone.substring(0, 3) + '****' + phone.substring(phone.length - 3);
      document.getElementById('parent-step-1').classList.add('hidden');
      document.getElementById('parent-step-2').classList.remove('hidden');
      document.getElementById('parent-otp-input').value = DEMO_OTP;
    }

    function parentBackToStep1() {
      document.getElementById('parent-step-2').classList.add('hidden');
      document.getElementById('parent-step-1').classList.remove('hidden');
    }

    function parentVerifyOtp() {
      const code = document.getElementById('parent-otp-input').value.trim();
      if (code !== DEMO_OTP) return showCustomAlert('رمز التحقق غير صحيح');
      document.getElementById('parent-greeting').innerText = `مرحباً ${currentParentData.parent_name} 👋`;
      renderParentStudentsList();
      renderPickupOptions();
      document.getElementById('parent-step-2').classList.add('hidden');
      document.getElementById('parent-step-3').classList.remove('hidden');
    }

    function renderParentStudentsList() {
      const container = document.getElementById('parent-students-list');
      container.innerHTML = '';
      currentSelectedStudentIds = [];
      currentParentData.students.forEach((st, idx) => {
        const grad = isGrad(st.class);
        const card = document.createElement('label');
        card.className = `p-4 rounded-2xl border-2 transition-all flex items-center justify-between ${grad ? 'bg-slate-50 border-slate-200 opacity-60' : 'bg-emerald-50/50 border-emerald-200 hover:border-emerald-500 cursor-pointer'}`;
        card.innerHTML = `
          <div class="flex items-center gap-3">
            <input type="checkbox" value="${esc(st.id)}" ${grad ? 'disabled' : 'checked'}
                   onchange="parentOnCheckboxChange(this.value, this.checked)" class="w-6 h-6 rounded-lg accent-emerald-600">
            <div>
              <p class="font-black text-slate-800 text-base">${esc(st.name)}</p>
              <p class="text-xs font-bold text-slate-500">${esc(st.class)}</p>
            </div>
          </div>
          ${grad ? '<span class="text-xs bg-slate-200 text-slate-700 px-2.5 py-1 rounded-full font-bold">خريج 🎓</span>' : '<span class="text-xs text-emerald-700 font-bold bg-white px-2 py-1 rounded-lg border border-emerald-200">طالب حالي</span>'}`;
        if (!grad) currentSelectedStudentIds.push(String(st.id));
        container.appendChild(card);
      });
    }

    function renderPickupOptions() {
      const sel = document.getElementById('parent-pickup-select');
      let h = `<option value="self">${esc(currentParentData.parent_name)} (ولي الأمر)</option>`;
      currentParentData.authorized_pickups.forEach((a, i) => {
        h += `<option value="${i}">${esc(a.name)} (${esc(a.relation || 'مفوَّض')}) ✓ مفوَّض</option>`;
      });
      h += `<option value="other">شخص آخر غير مسجل...</option>`;
      sel.innerHTML = h;
      onPickupSelectChange();
    }

    function onPickupSelectChange() {
      const other = document.getElementById('parent-pickup-select').value === 'other';
      document.getElementById('parent-pickup-person').classList.toggle('hidden', !other);
      document.getElementById('pickup-warning').classList.toggle('hidden', !other);
    }

    function parentOnCheckboxChange(id, checked) {
      id = String(id);
      if (checked) { if (!currentSelectedStudentIds.includes(id)) currentSelectedStudentIds.push(id); }
      else currentSelectedStudentIds = currentSelectedStudentIds.filter(x => x !== id);
    }

    function parentToggleSelectAll() {
      const boxes = document.querySelectorAll('#parent-students-list input[type="checkbox"]:not(:disabled)');
      const allChecked = Array.from(boxes).every(c => c.checked);
      currentSelectedStudentIds = [];
      boxes.forEach(c => { c.checked = !allChecked; if (!allChecked) currentSelectedStudentIds.push(c.value); });
      document.getElementById('btn-select-all').innerText = allChecked ? "تحديد الكل ✓" : "إلغاء التحديد ✕";
    }

    async function parentSubmitRequest() {
      if (currentSelectedStudentIds.length === 0) return showCustomAlert('يرجى تحديد طالب واحد على الأقل للاستئذان');

      const selVal = document.getElementById('parent-pickup-select').value;
      let pickupPerson, authorized = true;
      if (selVal === 'self') pickupPerson = `${currentParentData.parent_name} (ولي الأمر)`;
      else if (selVal === 'other') {
        pickupPerson = document.getElementById('parent-pickup-person').value.trim();
        if (!pickupPerson) return showCustomAlert('فضلاً اكتب اسم الشخص المستلم');
        authorized = false;
      } else {
        const a = currentParentData.authorized_pickups[+selVal];
        pickupPerson = `${a.name} (${a.relation || 'مفوَّض'})`;
      }
      const pickupTime = document.getElementById('parent-pickup-time').value || 'الآن';
      const carInfo = document.getElementById('parent-car-info').value.trim() || 'لم تُحدد';
      const selected = currentParentData.students.filter(s => currentSelectedStudentIds.includes(String(s.id)));

      for (const st of selected) {
        const order = {
          student_name: st.name, student_class: st.class, parent_name: currentParentData.parent_name,
          parent_national_id: currentParentData.parent_id, pickup_person: pickupPerson, pickup_authorized: authorized,
          pickup_time: pickupTime, car_info: carInfo, status: S_PENDING
        };
        if (isLiveSupabase) {
          const { error } = await supabaseClient.from('permission_requests').insert([order]);
          if (error) { console.error(error); return showCustomAlert('تعذر إرسال الطلب، يرجى المحاولة لاحقاً'); }
        } else {
          localMockDB.orders.unshift({ ...order, id: uid('req'), created_at: new Date().toISOString() });
        }
      }
      if (!isLiveSupabase) saveLocalMockDB();

      document.getElementById('parent-summary-box').innerHTML = `
        <div><strong>الطلاب:</strong> ${selected.map(s => esc(s.name)).join('، ')}</div>
        <div><strong>المستلم:</strong> ${esc(pickupPerson)} ${authorized ? '' : '<span class="text-amber-700">(غير مسجل)</span>'}</div>
        <div><strong>الوقت:</strong> ${esc(pickupTime)}</div>
        <div><strong>السيارة:</strong> ${esc(carInfo)}</div>`;
      document.getElementById('parent-step-3').classList.add('hidden');
      document.getElementById('parent-step-4').classList.remove('hidden');
    }

    function parentResetAll() {
      ['parent-national-id', 'parent-pickup-person', 'parent-pickup-time', 'parent-car-info'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('parent-step-4').classList.add('hidden');
      document.getElementById('parent-step-1').classList.remove('hidden');
    }

    // ==========================================
    // 📋 الطلبات
    // ==========================================
    async function refreshOrders() {
      if (isLiveSupabase) {
        try {
          const { data, error } = await supabaseClient.from('permission_requests').select('*').order('created_at', { ascending: false });
          if (error) throw error;
          ordersCache = data || [];
        } catch (e) { console.error(e); showCustomAlert('تعذر جلب الطلبات من السحابة'); }
      } else {
        ordersCache = localMockDB.orders;
      }

      const tbody = document.getElementById('admin-orders-table');
      const emptyMsg = document.getElementById('no-orders-msg');
      tbody.innerHTML = '';
      emptyMsg.classList.toggle('hidden', ordersCache.length > 0);

      ordersCache.forEach(ord => {
        let badge = "bg-amber-100 text-amber-800 border-amber-200";
        if (ord.status === S_READY) badge = "bg-blue-100 text-blue-800 border-blue-200";
        if (ord.status === S_DONE) badge = "bg-emerald-100 text-emerald-800 border-emerald-200";
        const unauth = ord.pickup_authorized === false;
        const parentCell = ord.parent_national_id
          ? `<button onclick="openParentDetails('${esc(ord.parent_national_id)}')" class="text-slate-700 hover:text-emerald-700 hover:underline font-bold text-right">${esc(ord.parent_name || '-')}</button>`
          : esc(ord.parent_name || '-');

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition " + (unauth && ord.status !== S_DONE ? 'bg-amber-50/40' : '');
        tr.innerHTML = `
          <td class="p-4 font-black text-slate-900">${esc(ord.student_name)}</td>
          <td class="p-4 font-bold text-slate-500">${esc(ord.student_class || '-')}</td>
          <td class="p-4">${parentCell}</td>
          <td class="p-4 font-bold ${unauth ? 'text-amber-800' : 'text-emerald-800'}">
            ${esc(ord.pickup_person || 'ولي الأمر')}
            ${unauth ? '<div class="text-[11px] font-black text-amber-700 mt-0.5">⚠️ غير مسجل - تحقق من الهوية</div>' : ''}
          </td>
          <td class="p-4 font-mono font-bold">${esc(ord.pickup_time || 'الآن')}<div class="text-[11px] text-slate-400 font-sans">طُلب ${esc(fmtTime(ord.created_at))}</div></td>
          <td class="p-4 text-slate-500">${esc(ord.car_info || '-')}</td>
          <td class="p-4 text-center"><span class="px-3 py-1 rounded-full text-xs font-black border whitespace-nowrap ${badge}">${esc(ord.status)}</span></td>
          <td class="p-4 text-center">
            ${ord.status === S_PENDING ? `<button onclick="updateOrderStatus('${esc(ord.id)}','ready')" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-xs shadow-sm whitespace-nowrap">تجهيز الطالب 🔔</button>` : ''}
            ${ord.status === S_READY ? `<button onclick="updateOrderStatus('${esc(ord.id)}','done')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-sm whitespace-nowrap">تأكيد الخروج ✓</button>` : ''}
            ${ord.status === S_DONE ? `<span class="text-slate-400 text-xs font-bold">مكتمل بالسلامة</span>` : ''}
          </td>`;
        tbody.appendChild(tr);
      });
      updateStats();
    }

    async function updateOrderStatus(orderId, step) {
      const next = step === 'ready' ? S_READY : S_DONE;
      if (isLiveSupabase) {
        const { error } = await supabaseClient.from('permission_requests').update({ status: next }).eq('id', orderId);
        if (error) { console.error(error); return showCustomAlert('تعذر تحديث حالة الطلب'); }
      } else {
        const o = localMockDB.orders.find(x => String(x.id) === String(orderId));
        if (o) { o.status = next; saveLocalMockDB(); }
      }
      refreshOrders();
    }

    function updateStats() {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v; };
      set('stat-today', ordersCache.filter(o => isToday(o.created_at)).length);
      set('stat-pending', ordersCache.filter(o => o.status === S_PENDING).length);
      set('stat-parents', parentsCache.length);
      set('stat-students', parentsCache.reduce((n, p) => n + p.students.filter(s => !isGrad(s.class)).length, 0));
      set('orders-count', ordersCache.filter(o => o.status !== S_DONE).length);
    }

    function matchParentOrder(p, o) {
      return o.parent_national_id ? o.parent_national_id === p.parent_id : o.parent_name === p.parent_name;
    }

    // ==========================================
    // 👥 سجل أولياء الأمور
    // ==========================================
    function renderParentsRegistry() {
      const q = (document.getElementById('parents-search').value || '').trim().toLowerCase();
      const f = document.getElementById('parents-filter').value;
      const list = parentsCache.filter(p => {
        if (f === 'verified' && !p.phone_verified) return false;
        if (f === 'unverified' && p.phone_verified) return false;
        if (f === 'notes' && !p.parent_notes) return false;
        if (!q) return true;
        const hay = [p.parent_name, p.parent_id, p.parent_phone, p.parent_alt_phone, p.parent_email,
          ...p.students.map(s => s.name), ...p.authorized_pickups.map(a => a.name)].join(' ').toLowerCase();
        return hay.includes(q);
      });

      const totalStudents = parentsCache.reduce((n, p) => n + p.students.length, 0);
      document.getElementById('parents-count-label').innerText =
        `${parentsCache.length} ولي أمر · ${totalStudents} طالب مرتبط` + (list.length !== parentsCache.length ? ` · المعروض ${list.length}` : '');
      document.getElementById('parents-grid').innerHTML = list.map(parentCardHtml).join('');
      document.getElementById('no-parents-msg').classList.toggle('hidden', list.length > 0);
    }

