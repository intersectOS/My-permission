      renderParentStudentsList();

      document.getElementById('parent-step-2').classList.add('hidden');
      document.getElementById('parent-step-3').classList.remove('hidden');
    }

    function renderParentStudentsList() {
      const container = document.getElementById('parent-students-list');
      container.innerHTML = '';
      currentSelectedStudentIds = [];

      currentParentData.students.forEach((st, idx) => {
        const isGraduated = (st.class || '').includes('تخرج');
        const card = document.createElement('div');
        card.className = `p-4 rounded-2xl border-2 transition-all flex items-center justify-between ${
          isGraduated ? 'bg-slate-50 border-slate-200 opacity-60' : 'bg-emerald-50/50 border-emerald-200 hover:border-emerald-500 cursor-pointer'
        }`;
        
        card.innerHTML = `
          <div class="flex items-center gap-3">
            <input type="checkbox" id="chk-st-${idx}" value="${st.id}" ${isGraduated ? 'disabled' : 'checked'}
                   onchange="parentOnCheckboxChange('${st.id}', this.checked)"
                   class="w-6 h-6 rounded-lg text-emerald-600 focus:ring-emerald-500 accent-emerald-600">
            <div>
              <p class="font-black text-slate-800 text-base">${st.name}</p>
              <p class="text-xs font-bold text-slate-500">${st.class}</p>
            </div>
          </div>
          ${isGraduated ? '<span class="text-xs bg-slate-200 text-slate-700 px-2.5 py-1 rounded-full font-bold">خريج 🎓</span>' : '<span class="text-xs text-emerald-700 font-bold bg-white px-2 py-1 rounded-lg border border-emerald-200">طالب حالي</span>'}
        `;

        if (!isGraduated) {
          currentSelectedStudentIds.push(st.id);
        }
        container.appendChild(card);
      });
    }

    function parentOnCheckboxChange(id, checked) {
      if (checked) {
        if (!currentSelectedStudentIds.includes(id)) currentSelectedStudentIds.push(id);
      } else {
        currentSelectedStudentIds = currentSelectedStudentIds.filter(item => item !== id);
      }
    }

    function parentToggleSelectAll() {
      const checkboxes = document.querySelectorAll('#parent-students-list input[type="checkbox"]:not(:disabled)');
      const allChecked = Array.from(checkboxes).every(c => c.checked);
      
      currentSelectedStudentIds = [];
      checkboxes.forEach(c => {
        c.checked = !allChecked;
        if (!allChecked) currentSelectedStudentIds.push(c.value);
      });

      document.getElementById('btn-select-all').innerText = allChecked ? "تحديد الكل ✓" : "إلغاء التحديد ✕";
    }

    async function parentSubmitRequest() {
      if (currentSelectedStudentIds.length === 0) {
        showCustomAlert('يرجى تحديد طالب واحد على الأقل للاستئذان');
        return;
      }

      const pickupPerson = document.getElementById('parent-pickup-person').value.trim() || `${currentParentData.parent_name} (ولي الأمر)`;
      const pickupTime = document.getElementById('parent-pickup-time').value || 'الآن';
      const carInfo = document.getElementById('parent-car-info').value.trim() || 'لم تُحدد';

      const selectedStudents = currentParentData.students.filter(s => currentSelectedStudentIds.includes(s.id));

      for (const st of selectedStudents) {
        const newOrder = {
          id: 'req-' + Date.now() + '-' + Math.floor(Math.random()*100),
          student_name: st.name,
          student_class: st.class,
          parent_name: currentParentData.parent_name,
          pickup_person: pickupPerson,
          pickup_time: pickupTime,
          car_info: carInfo,
          status: 'قيد الانتظار',
          created_at: new Date().toLocaleTimeString('ar-SA')
        };

        if (isLiveSupabase) {
          try {
            await supabaseClient.from('permission_requests').insert([{
              student_name: st.name,
              student_class: st.class,
              parent_name: currentParentData.parent_name,
              pickup_person: pickupPerson,
              pickup_time: pickupTime,
              car_info: carInfo,
              status: 'قيد الانتظار'
            }]);
          } catch (err) {
            console.error("فشل حفظ الطلب في Supabase:", err);
          }
        }

        localMockDB.orders.unshift(newOrder);
      }

      saveLocalMockDB();

      const summaryBox = document.getElementById('parent-summary-box');
      summaryBox.innerHTML = `
        <div><strong>الطلاب المستأذن لهم:</strong> ${selectedStudents.map(s => s.name).join('، ')}</div>
        <div><strong>الشخص المستلم:</strong> ${pickupPerson}</div>
        <div><strong>الوقت المحدد:</strong> ${pickupTime}</div>
        <div><strong>بيانات السيارة:</strong> ${carInfo}</div>
      `;

      document.getElementById('parent-step-3').classList.add('hidden');
      document.getElementById('parent-step-4').classList.remove('hidden');
    }

    function parentResetAll() {
      document.getElementById('parent-national-id').value = '';
      document.getElementById('parent-pickup-person').value = '';
      document.getElementById('parent-pickup-time').value = '';
      document.getElementById('parent-car-info').value = '';
      document.getElementById('parent-step-4').classList.add('hidden');
      document.getElementById('parent-step-1').classList.remove('hidden');
    }

    // ==========================================
    // 4️⃣ لوحة الإدارة: عرض وإدارة الطلبات المباشرة
    // ==========================================
    async function refreshOrders() {
      let ordersList = [];

      if (isLiveSupabase) {
        try {
          const { data, error } = await supabaseClient
            .from('permission_requests')
            .select('*')
            .order('created_at', { ascending: false });

          if (!error && data) {
            ordersList = data;
          }
        } catch (e) {
          console.error("تعذر جلب الطلبات من Supabase:", e);
        }
      }

      if (ordersList.length === 0) {
        ordersList = localMockDB.orders;
      }

      document.getElementById('orders-count').innerText = ordersList.length;

      const tbody = document.getElementById('admin-orders-table');
      const emptyMsg = document.getElementById('no-orders-msg');
      tbody.innerHTML = '';

      if (ordersList.length === 0) {
        emptyMsg.classList.remove('hidden');
        return;
      }
      emptyMsg.classList.add('hidden');

      ordersList.forEach(ord => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition border-b border-slate-100";

        let badgeClass = "bg-amber-100 text-amber-800 border-amber-200";
        if (ord.status === 'تم التجهيز عند البوابة') badgeClass = "bg-blue-100 text-blue-800 border-blue-200";
        if (ord.status === 'تم الخروج والتسليم ✓') badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";

        tr.innerHTML = `
          <td class="p-4 font-black text-slate-900">${ord.student_name}</td>
          <td class="p-4 font-bold text-slate-500">${ord.student_class || '-'}</td>
          <td class="p-4 text-slate-700">${ord.parent_name || '-'}</td>
          <td class="p-4 font-bold text-emerald-800">${ord.pickup_person || 'ولي الأمر'}</td>
          <td class="p-4 font-mono font-bold">${ord.pickup_time || 'الآن'}</td>
          <td class="p-4 text-slate-500">${ord.car_info || '-'}</td>
          <td class="p-4 text-center">
            <span class="px-3 py-1 rounded-full text-xs font-black border ${badgeClass}">
              ${ord.status}
            </span>
          </td>
          <td class="p-4 text-center space-x-1 space-x-reverse">
            ${ord.status === 'قيد الانتظار' ? `
              <button onclick="updateOrderStatus('${ord.id}', 'تم التجهيز عند البوابة')" 
                      class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-xs shadow-sm">
                تجهيز الطالب 🔔
              </button>
            ` : ''}
            ${ord.status === 'تم التجهيز عند البوابة' ? `
              <button onclick="updateOrderStatus('${ord.id}', 'تم الخروج والتسليم ✓')" 
                      class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-sm">
                تأكيد الخروج ✓
              </button>
            ` : ''}
            ${ord.status === 'تم الخروج والتسليم ✓' ? `
              <span class="text-slate-400 text-xs font-bold">مكتمل بالسلامة</span>
            ` : ''}
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function updateOrderStatus(orderId, nextStatus) {
      if (isLiveSupabase) {
        try {
          await supabaseClient
            .from('permission_requests')
            .update({ status: nextStatus })
            .eq('id', orderId);
        } catch (e) {
          console.error("خطأ تحديث حالة الطلب سحابياً:", e);
        }
      }

      const localOrd = localMockDB.orders.find(o => o.id === orderId);
      if (localOrd) {
        localOrd.status = nextStatus;
        saveLocalMockDB();
      }

      refreshOrders();
    }

    function setupRealtimeOrders() {
      if (!isLiveSupabase || !supabaseClient) return;
      supabaseClient
        .channel('public:permission_requests')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'permission_requests' }, () => {
          refreshOrders();
        })
        .subscribe();
    }

    // ==========================================
    // 5️⃣ لوحة الإدارة: إضافة ولي أمر وأكثر من طالب
    // ==========================================
    let studentRowCounter = 0;

    function addNewStudentRow(initialName = '', initialClass = '') {
      studentRowCounter++;
      const container = document.getElementById('students-inputs-container');
      const row = document.createElement('div');
      row.id = `student-row-${studentRowCounter}`;
      row.className = "grid grid-cols-1 md:grid-cols-12 gap-3 p-4 bg-slate-50 border border-slate-200 rounded-2xl items-end relative";

      row.innerHTML = `
        <div class="md:col-span-6">
          <label class="block text-xs font-bold text-slate-700 mb-1">اسم الطالب الرباعي:</label>
          <input type="text" name="student_names" required value="${initialName}" placeholder="سعود مشاري الجميل"
                 class="w-full p-2.5 bg-white border border-slate-300 rounded-xl text-xs sm:text-sm font-bold text-slate-800">
        </div>
        <div class="md:col-span-5">
          <label class="block text-xs font-bold text-slate-700 mb-1">الصف والشعبة (ابتدائي):</label>
          <select name="student_classes" required class="w-full p-2.5 bg-white border border-slate-300 rounded-xl text-xs sm:text-sm font-bold text-slate-800">
            <option value="الصف الأول ابتدائي / أ" ${initialClass.includes('الأول') ? 'selected' : ''}>الصف الأول ابتدائي / أ</option>
            <option value="الصف الأول ابتدائي / ب">الصف الأول ابتدائي / ب</option>
            <option value="الصف الثاني ابتدائي / أ" ${initialClass.includes('الثاني') ? 'selected' : ''}>الصف الثاني ابتدائي / أ</option>
            <option value="الصف الثاني ابتدائي / ب">الصف الثاني ابتدائي / ب</option>
            <option value="الصف الثالث ابتدائي / أ" ${initialClass.includes('الثالث') || !initialClass ? 'selected' : ''}>الصف الثالث ابتدائي / أ</option>
            <option value="الصف الثالث ابتدائي / ب">الصف الثالث ابتدائي / ب</option>
            <option value="الصف الرابع ابتدائي / أ" ${initialClass.includes('الرابع') ? 'selected' : ''}>الصف الرابع ابتدائي / أ</option>
            <option value="الصف الرابع ابتدائي / ب">الصف الرابع ابتدائي / ب</option>
            <option value="الصف الخامس ابتدائي / أ" ${initialClass.includes('الخامس') ? 'selected' : ''}>الصف الخامس ابتدائي / أ</option>
            <option value="الصف الخامس ابتدائي / ب">الصف الخامس ابتدائي / ب</option>
            <option value="الصف السادس ابتدائي / أ" ${initialClass.includes('السادس') ? 'selected' : ''}>الصف السادس ابتدائي / أ</option>
            <option value="الصف السادس ابتدائي / ب">الصف السادس ابتدائي / ب</option>
          </select>
        </div>
        <div class="md:col-span-1 flex justify-center">
          <button type="button" onclick="removeStudentRow('student-row-${studentRowCounter}')" 
                  class="p-2.5 text-rose-600 hover:bg-rose-50 rounded-xl border border-rose-200 transition text-xs font-bold">
            🗑️️
          </button>
        </div>
      `;

      container.appendChild(row);
      updateStudentsCounterText();
    }

    function removeStudentRow(rowId) {
      const container = document.getElementById('students-inputs-container');
      if (container.children.length <= 1) {
        showCustomAlert('يجب الإبقاء على طالب واحد على الأقل لولي الأمر!');
        return;
      }
      const el = document.getElementById(rowId);
      if (el) el.remove();
      updateStudentsCounterText();
    }

    function updateStudentsCounterText() {
      const count = document.getElementById('students-inputs-container').children.length;
      document.getElementById('students-counter').innerText = `${count} طلاب`;
    }

    async function handleSaveParentAndStudents(e) {
      e.preventDefault();
      const parentNid = document.getElementById('add-parent-nid').value.trim();
      const parentName = document.getElementById('add-parent-name').value.trim();
      const parentPhone = document.getElementById('add-parent-phone').value.trim();

      const nameInputs = document.getElementsByName('student_names');
      const classInputs = document.getElementsByName('student_classes');

      const studentsList = [];
      for (let i = 0; i < nameInputs.length; i++) {
        const sName = nameInputs[i].value.trim();
        const sClass = classInputs[i].value;
        if (sName) {
          studentsList.push({
            id: 'st-' + Date.now() + '-' + i,
            name: sName,
            class: sClass
          });
        }
      }

      if (studentsList.length === 0) {
        showCustomAlert('يرجى كتابة اسم طالب واحد على الأقل');
        return;
      }

      if (isLiveSupabase) {
        try {
          for (const st of studentsList) {
            const { data: stData } = await supabaseClient
              .from('students')
              .insert([{ full_name: st.name, grade_class: st.class }])
              .select();

            const stId = (stData && stData[0]) ? stData[0].id : null;

            await supabaseClient
              .from('parent_students')
              .insert([{
                parent_national_id: parentNid,
                parent_name: parentName,
                parent_phone: parentPhone,
                student_id: stId
              }]);
          }
        } catch (err) {
          console.error("خطأ حفظ البيانات سحابياً:", err);
        }
      }

      const existingParentIdx = localMockDB.parents.findIndex(p => p.parent_id === parentNid);
      if (existingParentIdx >= 0) {
        localMockDB.parents[existingParentIdx].students.push(...studentsList);
      } else {
        localMockDB.parents.push({
          parent_id: parentNid,
          parent_name: parentName,
          parent_phone: parentPhone,
          students: studentsList
        });
      }
      saveLocalMockDB();

      showCustomAlert(`✅ تم حفظ ولي الأمر (${parentName}) وربط (${studentsList.length}) من الأبناء بنجاح!`);
      e.target.reset();
      document.getElementById('students-inputs-container').innerHTML = '';
      addNewStudentRow();
      switchAdminTab('orders');
    }

    // ==========================================
    // 6️⃣ نظام الترحيل والترقية للسنوات الست الابتدائية
    // ==========================================
    const PRIMARY_PROGRESSION = {
      'الأول': 'الثاني',
      'الثاني': 'الثالث',
      'الثالث': 'الرابع',
      'الرابع': 'الخامس',
      'الخامس': 'السادس'
    };

    function calculateNextPrimaryGrade(currentGrade) {
      if (!currentGrade) return 'الصف الثاني ابتدائي / أ';
      if (currentGrade.includes('السادس')) {
        return 'تم التخرج الله يوفقه 🎓';
      }

      for (const [curr, nxt] of Object.entries(PRIMARY_PROGRESSION)) {
        if (currentGrade.includes(curr)) {
          return currentGrade.replace(curr, nxt);
        }
      }
      return currentGrade + ' (مترقى)';
    }

    let allStudentsForPromotion = [];

    async function loadPromoteStudentsList() {
      allStudentsForPromotion = [];

      if (isLiveSupabase) {
        try {
          const { data, error } = await supabaseClient
            .from('parent_students')
            .select('parent_name, student_id, students(id, full_name, grade_class)');

          if (!error && data && data.length > 0) {
            data.forEach(item => {
              if (item.students) {
                allStudentsForPromotion.push({
                  id: item.students.id,
                  name: item.students.full_name,
                  class: item.students.grade_class,
                  parent_name: item.parent_name
                });
              }
            });
          }
        } catch (e) {
          console.log("خطأ جلب طلاب الترقية:", e);
        }
      }

      if (allStudentsForPromotion.length === 0) {
        localMockDB.parents.forEach(p => {
          p.students.forEach(st => {
            allStudentsForPromotion.push({
              id: st.id,
              name: st.name,
              class: st.class,
              parent_name: p.parent_name
            });
          });
        });
      }

      const tbody = document.getElementById('promote-students-tbody');
      tbody.innerHTML = '';

      allStudentsForPromotion.forEach((st, idx) => {
        const nextGrade = calculateNextPrimaryGrade(st.class);
        const isGraduated = (st.class || '').includes('تخرج');
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition border-b border-slate-100";

        tr.innerHTML = `
          <td class="p-3.5 text-center">
            <input type="checkbox" id="promote-chk-${idx}" ${isGraduated ? 'disabled' : 'checked'}
                   class="w-5 h-5 rounded text-emerald-600 focus:ring-emerald-500 accent-emerald-600">
          </td>
          <td class="p-3.5 font-black text-slate-800">${st.name}</td>
          <td class="p-3.5 text-slate-500">${st.parent_name || '-'}</td>
          <td class="p-3.5 font-bold text-slate-600">${st.class}</td>
          <td class="p-3.5">
            <input type="text" id="promote-target-${idx}" value="${nextGrade}" ${isGraduated ? 'disabled' : ''}
                   class="p-2 border border-slate-300 rounded-xl text-xs font-bold w-full max-w-xs ${nextGrade.includes('التخرج') ? 'bg-amber-50 text-amber-900 border-amber-300 font-black' : 'bg-white text-emerald-800'}">
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function promoteSelectAll(status) {
      const chks = document.querySelectorAll('#promote-students-tbody input[type="checkbox"]:not(:disabled)');
      chks.forEach(c => c.checked = status);
    }

    async function executeBatchPromotion() {
      let promotedCount = 0;
      let heldBackCount = 0;

      for (let i = 0; i < allStudentsForPromotion.length; i++) {
        const chk = document.getElementById(`promote-chk-${i}`);
        if (!chk || chk.disabled) continue;

        const st = allStudentsForPromotion[i];
        if (chk.checked) {
          const newGrade = document.getElementById(`promote-target-${i}`).value;
          st.class = newGrade;
          promotedCount++;

          if (isLiveSupabase) {
            try {
              await supabaseClient
                .from('students')
                .update({ grade_class: newGrade })
                .eq('id', st.id);
            } catch (e) {
              console.error("فشل ترحيل الطالب سحابياً:", e);
            }
          }

          localMockDB.parents.forEach(p => {
            const found = p.students.find(s => s.id === st.id);
            if (found) found.class = newGrade;
          });

        } else {
          heldBackCount++;
        }
      }

      saveLocalMockDB();
      showCustomAlert(`🎉 تمت عملية الترحيل بنجاح!\n• عدد الطلاب المُرَقّين: ${promotedCount}\n• عدد الطلاب الباقين للإعادة: ${heldBackCount}`);
      loadPromoteStudentsList();
    }

    // ==========================================
    // 7️⃣ إعدادات Supabase ومساعد التنبيهات
    // ==========================================
    function openSupabaseConfigModal() {
      document.getElementById('cfg-supa-url').value = localStorage.getItem('supabase_url') || DEFAULT_SUPABASE_URL;
      document.getElementById('cfg-supa-key').value = localStorage.getItem('supabase_key') || DEFAULT_SUPABASE_KEY;
      document.getElementById('modal-supabase-config').classList.remove('hidden');
    }

    function closeSupabaseConfigModal() {
      document.getElementById('modal-supabase-config').classList.add('hidden');
    }

    function saveSupabaseConfig() {
      const url = document.getElementById('cfg-supa-url').value.trim();
      const key = document.getElementById('cfg-supa-key').value.trim();
      localStorage.setItem('supabase_url', url);
      localStorage.setItem('supabase_key', key);
      showCustomAlert('تم حفظ إعدادات Supabase بنجاح');
      location.reload();
    }

    // بديل خفيف وأنيق للتنبيهات
    function showCustomAlert(message) {
      const toast = document.createElement('div');
      toast.className = 'fixed bottom-5 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-6 py-3.5 rounded-2xl text-sm font-bold shadow-2xl z-50 transition-all border border-slate-700 max-w-sm text-center';
      toast.innerText = message;
      document.body.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }, 3500);
    }

    // التهيئة عند تحميل الصفحة
    window.addEventListener('DOMContentLoaded', () => {
      initSupabase();
      if (sessionStorage.getItem('is_admin_logged_in') === 'true') {
        isAdminAuthenticated = true;
      }
      refreshOrders();
      addNewStudentRow("سعود مشاري الجميل", "الصف الثالث ابتدائي / أ");
    });
  </script>
