    let currentParentData = null;
    let currentSelectedStudentIds = [];

    async function parentCheckIdentity() {
      const nid = document.getElementById('parent-national-id').value.trim();
      if (!nid || nid.length !== 10) {
        showCustomAlert('فضلاً أدخل رقم هوية وطنية صحيح مكوّن من 10 أرقام');
        return;
      }

      let parentFound = null;

      // محاولة البحث في Supabase السحابي أولاً
      if (isLiveSupabase) {
        try {
          const { data, error } = await supabaseClient
            .from('parent_students')
            .select('parent_national_id, parent_name, parent_phone, student_id, students(id, full_name, grade_class)')
            .eq('parent_national_id', nid);

          if (!error && data && data.length > 0) {
            parentFound = {
              parent_id: data[0].parent_national_id,
              parent_name: data[0].parent_name,
              parent_phone: data[0].parent_phone,
              students: data.map(d => ({
                id: d.students?.id || d.student_id,
                name: d.students?.full_name || 'طالب مسجل',
                class: d.students?.grade_class || 'ابتدائي'
              }))
            };
          }
        } catch (err) {
          console.log("خطأ استعلام Supabase، التحقق محلياً:", err);
        }
      }

      if (!parentFound) {
        parentFound = localMockDB.parents.find(p => p.parent_id === nid);
      }

      if (!parentFound) {
        showCustomAlert('رقم الهوية الوطنية هذا غير مسجل في مدرسة ابتدائية إبن الهيثم (بنين). يرجى التواصل مع إدارة المدرسة لإضافتكم.');
        return;
      }

      currentParentData = parentFound;

      const phone = currentParentData.parent_phone || '0500000000';
      const masked = phone.substring(0, 3) + '****' + phone.substring(phone.length - 3);
      document.getElementById('parent-masked-phone').innerText = masked;

      document.getElementById('parent-step-1').classList.add('hidden');
      document.getElementById('parent-step-2').classList.remove('hidden');
      document.getElementById('parent-otp-input').value = '123456';
    }

