          <button onclick="closeModal('modal-parent-details'); openParentEdit('${esc(p.parent_id)}')" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl">✏️ تعديل البيانات</button>
        </div>`;
      openModal('modal-parent-details');
    }

    function exportParentsCSV() {
      if (!parentsCache.length) return showCustomAlert('لا توجد بيانات للتصدير');
      const cell = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
      const num = v => v ? cell('="' + v + '"') : cell('');
      const header = ['اسم ولي الأمر', 'صلة القرابة', 'رقم الهوية', 'الجوال', 'جوال بديل', 'البريد الإلكتروني', 'الجوال موثّق', 'الأبناء', 'المفوَّضون بالاستلام', 'ملاحظات'];
      const rows = parentsCache.map(p => [
        cell(p.parent_name), cell(p.parent_relation), num(p.parent_id), num(p.parent_phone), num(p.parent_alt_phone),
        cell(p.parent_email), cell(p.phone_verified ? 'نعم' : 'لا'),
        cell(p.students.map(s => `${s.name} - ${s.class}`).join(' | ')),
        cell(p.authorized_pickups.map(a => `${a.name} (${a.relation || '-'}) ${a.phone || ''}`).join(' | ')),
        cell(p.parent_notes)
      ].join(','));
      const csv = '\uFEFF' + header.map(cell).join(',') + '\n' + rows.join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `سجل-أولياء-الأمور-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a); a.click(); a.remove();
    }

    // ==========================================
    // 📝 نموذج ولي الأمر (مشترك بين التسجيل والتعديل)
    // ==========================================
    function fieldHtml(id, label, type, ph, extra = '') {
      return `<div><label class="lbl">${label}</label><input type="${type}" id="${id}" placeholder="${ph}" ${extra} class="inp"></div>`;
    }

    function parentFormBodyHtml(pre) {
      return `
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-4">
          <h4 class="font-black text-sm text-slate-800">👤 بيانات ولي الأمر</h4>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            ${fieldHtml(pre + '-parent-nid', 'رقم الهوية الوطنية / الإقامة *', 'text', 'مثال: 1012345678', 'maxlength="10" inputmode="numeric" required')}
            ${fieldHtml(pre + '-parent-name', 'اسم ولي الأمر الرباعي *', 'text', 'مشاري سعود الجميل', 'required')}
            <div><label class="lbl">صلة القرابة بالطالب *</label><select id="${pre}-parent-relation" class="inp">${RELATIONS.map(r => `<option value="${r}">${r}</option>`).join('')}</select></div>
            ${fieldHtml(pre + '-parent-phone', 'رقم الجوال (لاستلام OTP) *', 'tel', '05xxxxxxxx', 'maxlength="10" inputmode="numeric" required')}
            ${fieldHtml(pre + '-parent-alt-phone', 'جوال بديل للطوارئ', 'tel', '05xxxxxxxx', 'maxlength="10" inputmode="numeric"')}
            ${fieldHtml(pre + '-parent-email', 'البريد الإلكتروني (اختياري)', 'email', 'name@example.com', 'dir="ltr"')}
          </div>
          <label class="flex items-start gap-3 p-3 bg-white border border-slate-200 rounded-xl cursor-pointer">
            <input type="checkbox" id="${pre}-parent-verified" class="w-5 h-5 mt-0.5 accent-emerald-600">
            <span class="text-xs font-bold text-slate-700">رقم الجوال موثّق ومسجّل باسم صاحب الهوية في أبشر<br><span class="text-slate-400 font-medium">يُفعَّل بعد التحقق من مطابقة الجوال مع رقم الهوية الوطنية</span></span>
          </label>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
          <div class="flex items-center justify-between gap-2">
            <div>
              <h4 class="font-black text-sm text-slate-800">🛡️ المفوَّضون بالاستلام (اختياري)</h4>
              <p class="text-[11px] text-slate-500 font-medium">أشخاص يحق لهم استلام الطالب نيابة عن ولي الأمر، ويظهرون له كخيارات عند الاستئذان.</p>
            </div>
            <button type="button" onclick="addAuthRow('${pre}-auth-container')" class="px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded-xl text-xs font-bold whitespace-nowrap">➕ إضافة مفوَّض</button>
          </div>
          <div id="${pre}-auth-container" class="space-y-2"></div>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-2">
          <h4 class="font-black text-sm text-slate-800">📝 ملاحظات وتنبيهات للإدارة</h4>
          <textarea id="${pre}-parent-notes" rows="2" placeholder="مثال: يُسلَّم الطالب للأم أو الجد فقط، أو أي ظرف خاص يجب أن يعرفه الوكيل" class="inp"></textarea>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="font-black text-sm text-slate-800 flex items-center gap-2">
              <span>🎒 الأبناء المسجلون في المدرسة</span>
              <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full" id="${pre}-students-counter">طالب واحد</span>
            </h4>
            <button type="button" onclick="addStudentRowTo('${pre}-students-container')" class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-xl text-xs font-bold">➕ إضافة طالب</button>
          </div>
          <div id="${pre}-students-container" class="space-y-3"></div>
        </div>`;
    }

    function addAuthRow(containerId, d = {}) {
      const row = document.createElement('div');
      row.className = 'auth-row grid grid-cols-2 sm:grid-cols-12 gap-2 p-3 bg-white border border-slate-200 rounded-xl items-end';
      row.innerHTML = `
        <div class="col-span-2 sm:col-span-4"><label class="lbl">الاسم *</label><input class="a-name inp" value="${esc(d.name)}" placeholder="عثمان سعود الجميل"></div>
        <div class="sm:col-span-2"><label class="lbl">القرابة</label><input class="a-rel inp" value="${esc(d.relation)}" placeholder="عم"></div>
        <div class="sm:col-span-3"><label class="lbl">رقم الهوية</label><input class="a-nid inp" maxlength="10" inputmode="numeric" value="${esc(d.nid)}" placeholder="1xxxxxxxxx"></div>
        <div class="sm:col-span-2"><label class="lbl">الجوال</label><input class="a-phone inp" maxlength="10" inputmode="numeric" value="${esc(d.phone)}" placeholder="05xxxxxxxx"></div>
        <div class="sm:col-span-1 flex justify-center"><button type="button" onclick="this.closest('.auth-row').remove()" class="p-2.5 text-rose-600 hover:bg-rose-50 rounded-xl border border-rose-200 text-xs">🗑️</button></div>`;
      document.getElementById(containerId).appendChild(row);
    }

    function readAuthRows(containerId) {
      return [...document.querySelectorAll('#' + containerId + ' .auth-row')].map(r => ({
        name: r.querySelector('.a-name').value.trim(),
        relation: r.querySelector('.a-rel').value.trim(),
        nid: r.querySelector('.a-nid').value.trim(),
        phone: r.querySelector('.a-phone').value.trim()
      })).filter(a => a.name);
    }

    function addStudentRowTo(containerId, d = {}) {
      const row = document.createElement('div');
      row.className = 'student-row grid grid-cols-1 md:grid-cols-12 gap-3 p-4 bg-slate-50 border border-slate-200 rounded-2xl items-end';
      row.dataset.id = d.id != null ? String(d.id) : '';
      row.innerHTML = `
        <div class="md:col-span-6"><label class="lbl">اسم الطالب الرباعي:</label><input type="text" class="st-name inp" value="${esc(d.name)}" placeholder="سعود مشاري الجميل"></div>
        <div class="md:col-span-5"><label class="lbl">الصف والشعبة:</label><select class="st-class inp">${classOptions(d.class || 'الصف الأول ابتدائي / أ')}</select></div>
        <div class="md:col-span-1 flex justify-center"><button type="button" onclick="removeStudentRow(this, '${containerId}')" class="p-2.5 text-rose-600 hover:bg-rose-50 rounded-xl border border-rose-200 text-xs">🗑️</button></div>`;
      document.getElementById(containerId).appendChild(row);
      updateStudentsCounterText(containerId);
    }

    function removeStudentRow(btn, containerId) {
      const c = document.getElementById(containerId);
      if (c.querySelectorAll('.student-row').length <= 1) return showCustomAlert('يجب الإبقاء على طالب واحد على الأقل لولي الأمر!');
      btn.closest('.student-row').remove();
      updateStudentsCounterText(containerId);
    }

    function updateStudentsCounterText(containerId) {
      const n = document.getElementById(containerId).querySelectorAll('.student-row').length;
      const el = document.getElementById(containerId.replace('-students-container', '-students-counter'));
      if (el) el.innerText = n === 1 ? 'طالب واحد' : n === 2 ? 'طالبان' : `${n} طلاب`;
    }

    function readStudentRows(containerId) {
      return [...document.querySelectorAll('#' + containerId + ' .student-row')].map(r => ({
        id: r.dataset.id || null,
        name: r.querySelector('.st-name').value.trim(),
        class: r.querySelector('.st-class').value
      })).filter(s => s.name);
    }

    function readParentForm(pre) {
      const v = id => document.getElementById(`${pre}-${id}`).value.trim();
      return {
        parent_id: v('parent-nid'), parent_name: v('parent-name'), parent_relation: v('parent-relation'),
        parent_phone: v('parent-phone'), parent_alt_phone: v('parent-alt-phone'), parent_email: v('parent-email'),
        phone_verified: document.getElementById(`${pre}-parent-verified`).checked,
        parent_notes: v('parent-notes'),
        authorized_pickups: readAuthRows(`${pre}-auth-container`),
        students: readStudentRows(`${pre}-students-container`)
      };
    }

    function validateParent(d) {
      if (!NID_RE.test(d.parent_id)) return 'رقم الهوية يجب أن يتكون من 10 أرقام ويبدأ بـ 1 أو 2';
      if (d.parent_name.split(/\s+/).filter(Boolean).length < 3) return 'اكتب اسم ولي الأمر ثلاثياً على الأقل';
      if (!PHONE_RE.test(d.parent_phone)) return 'رقم الجوال يجب أن يبدأ بـ 05 ويتكون من 10 أرقام';
      if (d.parent_alt_phone && !PHONE_RE.test(d.parent_alt_phone)) return 'الجوال البديل يجب أن يبدأ بـ 05 ويتكون من 10 أرقام';
      if (d.parent_alt_phone && d.parent_alt_phone === d.parent_phone) return 'الجوال البديل مطابق للجوال الأساسي';
      if (d.parent_email && !EMAIL_RE.test(d.parent_email)) return 'صيغة البريد الإلكتروني غير صحيحة';
      for (const a of d.authorized_pickups) {
        if (a.nid && !NID_RE.test(a.nid)) return `رقم هوية المفوَّض (${a.name}) غير صحيح`;
        if (a.phone && !PHONE_RE.test(a.phone)) return `رقم جوال المفوَّض (${a.name}) غير صحيح`;
      }
      if (!d.students.length) return 'أضف طالباً واحداً على الأقل';
      return '';
    }

    function resetAddForm() {
      document.getElementById('add-form-body').innerHTML = parentFormBodyHtml('add');
      addStudentRowTo('add-students-container');
    }

    async function handleSaveParentAndStudents(e) {
      e.preventDefault();
      const d = readParentForm('add');
      const err = validateParent(d);
      if (err) return showCustomAlert(err);

      await loadParents();
      const existing = parentsCache.find(p => p.parent_id === d.parent_id);
      if (existing && !confirm(`ولي الأمر (${existing.parent_name}) مسجل مسبقاً.\nهل تريد إضافة الأبناء الجدد إلى سجله وتحديث بياناته؟`)) return;

      try {
        if (isLiveSupabase) {
          for (const st of d.students) {
            const { data: stData, error: e1 } = await supabaseClient.from('students').insert([{ full_name: st.name, grade_class: st.class }]).select();
            if (e1) throw e1;
            const { error: e2 } = await supabaseClient.from('parent_students').insert([{ ...parentRowFields(d), student_id: stData[0].id }]);
            if (e2) throw e2;
          }
          const { error: e3 } = await supabaseClient.from('parent_students').update(parentRowFields(d)).eq('parent_national_id', d.parent_id);
          if (e3) throw e3;
        } else {
          const students = d.students.map(s => ({ id: uid('st'), name: s.name, class: s.class }));
          const target = localMockDB.parents.find(p => p.parent_id === d.parent_id);
          if (target) Object.assign(target, { ...d, students: [...target.students, ...students] });
          else localMockDB.parents.push({ ...d, students });
          saveLocalMockDB();
        }
      } catch (x) {
        console.error(x);
        return showCustomAlert('تعذر الحفظ: ' + (x.message || ''));
      }

      showCustomAlert(`✅ تم حفظ ولي الأمر (${d.parent_name}) وربط (${d.students.length}) من الأبناء بنجاح!`);
      resetAddForm();
      switchAdminTab('parents');
    }

    function openParentEdit(nid) {
      const p = parentsCache.find(x => x.parent_id === nid);
      if (!p) return;
      document.getElementById('edit-form-body').innerHTML = parentFormBodyHtml('edit');
      const set = (id, v) => document.getElementById('edit-' + id).value = v || '';
      set('parent-nid', p.parent_id);
      document.getElementById('edit-parent-nid').readOnly = true;
      document.getElementById('edit-parent-nid').classList.add('bg-slate-100', 'text-slate-500');
      set('parent-name', p.parent_name);
      const relSel = document.getElementById('edit-parent-relation');
      if (!RELATIONS.includes(p.parent_relation)) relSel.insertAdjacentHTML('beforeend', `<option value="${esc(p.parent_relation)}">${esc(p.parent_relation)}</option>`);
      relSel.value = p.parent_relation;
      set('parent-phone', p.parent_phone);
      set('parent-alt-phone', p.parent_alt_phone);
      set('parent-email', p.parent_email);
      set('parent-notes', p.parent_notes);
      document.getElementById('edit-parent-verified').checked = p.phone_verified;
      p.authorized_pickups.forEach(a => addAuthRow('edit-auth-container', a));
      p.students.forEach(s => addStudentRowTo('edit-students-container', s));
      openModal('modal-parent-edit');
    }

    async function handleSaveParentEdit(e) {
      e.preventDefault();
      const d = readParentForm('edit');
      const err = validateParent(d);
      if (err) return showCustomAlert(err);
      const original = parentsCache.find(p => p.parent_id === d.parent_id);
      if (!original) return;
      const btn = document.getElementById('btn-save-edit');
      btn.disabled = true; btn.innerText = 'جارٍ الحفظ...';

      try {
        if (isLiveSupabase) {
          const keptIds = d.students.filter(s => s.id).map(s => String(s.id));
          const removed = original.students.filter(s => !keptIds.includes(String(s.id)));
          for (const s of d.students) {
            if (s.id) {
              const orig = original.students.find(o => String(o.id) === String(s.id));
              const { error } = await supabaseClient.from('students').update({ full_name: s.name, grade_class: s.class }).eq('id', orig ? orig.id : s.id);
              if (error) throw error;
            } else {
              const { data: stData, error: e1 } = await supabaseClient.from('students').insert([{ full_name: s.name, grade_class: s.class }]).select();
              if (e1) throw e1;
              const { error: e2 } = await supabaseClient.from('parent_students').insert([{ ...parentRowFields(d), student_id: stData[0].id }]);
              if (e2) throw e2;
            }
          }
          for (const s of removed) {
            await supabaseClient.from('parent_students').delete().eq('parent_national_id', d.parent_id).eq('student_id', s.id);
            await deleteOrphanStudents([s.id]);
          }
          const { error: e3 } = await supabaseClient.from('parent_students').update(parentRowFields(d)).eq('parent_national_id', d.parent_id);
          if (e3) throw e3;
        } else {
          const target = localMockDB.parents.find(p => p.parent_id === d.parent_id);
          Object.assign(target, { ...d, students: d.students.map(s => ({ id: s.id || uid('st'), name: s.name, class: s.class })) });
          saveLocalMockDB();
        }
        showCustomAlert('✅ تم حفظ التعديلات بنجاح');
        closeModal('modal-parent-edit');
        await loadParents();
        renderParentsRegistry();
      } catch (x) {
        console.error(x);
        showCustomAlert('تعذر الحفظ: ' + (x.message || ''));
      } finally {
        btn.disabled = false; btn.innerText = 'حفظ التعديلات ✓';
      }
    }

    // حذف سجلات الطلاب التي لم تعد مرتبطة بأي ولي أمر
    async function deleteOrphanStudents(ids) {
      if (!ids.length) return;
      const { data } = await supabaseClient.from('parent_students').select('student_id').in('student_id', ids);
      const stillLinked = (data || []).map(r => String(r.student_id));
      const orphans = ids.filter(id => !stillLinked.includes(String(id)));
      if (orphans.length) await supabaseClient.from('students').delete().in('id', orphans);
    }

    async function deleteParent(nid) {
      const p = parentsCache.find(x => x.parent_id === nid);
      if (!p) return;
      if (!confirm(`سيتم حذف ولي الأمر (${p.parent_name}) وأبنائه (${p.students.length}) من النظام نهائياً.\nهل أنت متأكد؟`)) return;
      try {
        if (isLiveSupabase) {
          const { error } = await supabaseClient.from('parent_students').delete().eq('parent_national_id', nid);
          if (error) throw error;
          await deleteOrphanStudents(p.students.map(s => s.id).filter(Boolean));
        } else {
          localMockDB.parents = localMockDB.parents.filter(x => x.parent_id !== nid);
          saveLocalMockDB();
        }
        showCustomAlert('🗑️ تم حذف ولي الأمر من السجل');
        await loadParents();
        renderParentsRegistry();
      } catch (x) {
        console.error(x);
        showCustomAlert('تعذر الحذف: ' + (x.message || ''));
      }
    }

    // ==========================================
    // 🎓 الترحيل السنوي
    // ==========================================
    const PRIMARY_PROGRESSION = { 'الأول': 'الثاني', 'الثاني': 'الثالث', 'الثالث': 'الرابع', 'الرابع': 'الخامس', 'الخامس': 'السادس' };

    function calculateNextPrimaryGrade(g) {
      if (!g) return 'الصف الثاني ابتدائي / أ';
      if (g.includes('السادس')) return 'تم التخرج الله يوفقه 🎓';
      for (const [c, n] of Object.entries(PRIMARY_PROGRESSION)) if (g.includes(c)) return g.replace(c, n);
      return g;
    }

    let allStudentsForPromotion = [];

    async function loadPromoteStudentsList() {
      await loadParents();
      const seen = new Set();
      allStudentsForPromotion = [];
      parentsCache.forEach(p => p.students.forEach(st => {
        if (seen.has(String(st.id))) return;
        seen.add(String(st.id));
        allStudentsForPromotion.push({ id: st.id, name: st.name, class: st.class, parent_name: p.parent_name });
      }));

      const tbody = document.getElementById('promote-students-tbody');
      tbody.innerHTML = '';
      allStudentsForPromotion.forEach((st, idx) => {
        const next = calculateNextPrimaryGrade(st.class);
        const grad = isGrad(st.class);
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition";
        tr.innerHTML = `
          <td class="p-3.5 text-center"><input type="checkbox" id="promote-chk-${idx}" ${grad ? 'disabled' : 'checked'} class="w-5 h-5 rounded accent-emerald-600"></td>
          <td class="p-3.5 font-black text-slate-800">${esc(st.name)}</td>
          <td class="p-3.5 text-slate-500">${esc(st.parent_name || '-')}</td>
          <td class="p-3.5 font-bold text-slate-600">${esc(st.class)}</td>
          <td class="p-3.5"><input type="text" id="promote-target-${idx}" value="${esc(next)}" ${grad ? 'disabled' : ''}
              class="p-2 border border-slate-300 rounded-xl text-xs font-bold w-full max-w-xs ${next.includes('التخرج') ? 'bg-amber-50 text-amber-900 border-amber-300 font-black' : 'bg-white text-emerald-800'}"></td>`;
        tbody.appendChild(tr);
      });
    }

    function promoteSelectAll(status) {
      document.querySelectorAll('#promote-students-tbody input[type="checkbox"]:not(:disabled)').forEach(c => c.checked = status);
    }

    async function executeBatchPromotion() {
      if (!confirm('سيتم ترحيل جميع الطلاب المحددين إلى الصف التالي. متابعة؟')) return;
      let promoted = 0, held = 0;
      for (let i = 0; i < allStudentsForPromotion.length; i++) {
        const chk = document.getElementById(`promote-chk-${i}`);
        if (!chk || chk.disabled) continue;
        const st = allStudentsForPromotion[i];
        if (!chk.checked) { held++; continue; }
        const newGrade = document.getElementById(`promote-target-${i}`).value;
        if (isLiveSupabase) {
          const { error } = await supabaseClient.from('students').update({ grade_class: newGrade }).eq('id', st.id);
          if (error) { console.error(error); continue; }
        } else {
          localMockDB.parents.forEach(p => { const f = p.students.find(s => String(s.id) === String(st.id)); if (f) f.class = newGrade; });
        }
        promoted++;
      }
      if (!isLiveSupabase) saveLocalMockDB();
      showCustomAlert(`🎉 تمت عملية الترحيل بنجاح!\n• الطلاب المُرَقّون: ${promoted}\n• الباقون للإعادة: ${held}`);
      loadPromoteStudentsList();
    }

    // ==========================================
    // 🚀 التهيئة
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      initSupabase();
      resetAddForm();
      if (sessionStorage.getItem('is_admin_logged_in') === 'true') isAdminAuthenticated = true;
      refreshOrders();
      loadParents();
    });
  </script>
</body>
