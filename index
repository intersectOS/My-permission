            .eq('setting_key', 'admin_password')
            .maybeSingle();

          if (!error && data && data.setting_value) {
            localStorage.setItem('school_admin_password', data.setting_value);
            return data.setting_value;
          }
        } catch (e) {
          console.warn("جلب كلمة المرور من السحابة واجه خطأ، الاعتماد على التخزين المحلي:", e);
        }
      }

      // 2. قراءة محلية احتياطية أو الافتراضية
      return localStorage.getItem('school_admin_password') || DEFAULT_ADMIN_PASSWORD;
    }

    async function handleAdminLogin(e) {
      e.preventDefault();
      const loginBtn = document.getElementById('admin-login-btn');
      const enteredPassword = document.getElementById('input-admin-password').value.trim();
      const errorDiv = document.getElementById('admin-login-error');

      loginBtn.disabled = true;
      loginBtn.innerHTML = `<span>جارٍ التحقق... ⏳</span>`;

      try {
        const currentPassword = await getAdminPasswordAsync();

        if (enteredPassword === currentPassword) {
          isAdminAuthenticated = true;
          sessionStorage.setItem('is_admin_logged_in', 'true');
          errorDiv.classList.add('hidden');
          document.getElementById('input-admin-password').value = '';
          renderAdminView();
        } else {
          errorDiv.classList.remove('hidden');
        }
      } catch (err) {
        console.error("خطأ تسجيل الدخول:", err);
        errorDiv.classList.remove('hidden');
      } finally {
        loginBtn.disabled = false;
        loginBtn.innerHTML = `<span>دخول للوحة التحكم 🚪</span>`;
      }
    }

